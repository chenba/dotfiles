(defvar
  time-repress-timeout 75
  hold-timeout         175
  tt $time-repress-timeout
  ht $hold-timeout
)

;; home row mods
(defalias
  a-ctl    (tap-hold-release $tt $ht a ctl)
  scln-ctl (tap-hold-release $tt $ht ; ctl)
)

;; nav
(defalias
  esc-nav (tap-hold-release $tt $ht esc (layer-toggle nav))
  quot-nav (tap-hold-release $tt $ht ' (layer-toggle nav))

  ;; macos
  newtab M-t
  deltab M-w
  ltab   M-S-[
  rtab   M-S-]
  yank   M-c
  put    M-v
  undo   M-z
  grep   M-f
  shcat  C-spc
  rcast  A-spc
  lock   C-M-q
)

;; apps and windows
(defvirtualkeys
  firefox    (cmd osascript -e r#"activate application "Firefox""#)
  ff-nightly (cmd osascript -e r#"activate application "Macintosh HD:Applications:Firefox Nightly.app""#)
  kitty      (cmd osascript -e r#"activate application "kitty""#)
  v-cmd      lmet
)
(defalias
  f-apps     (tap-hold-tap-keys $tt $ht 
               f 
               (multi (layer-toggle apps-windows) (on-release release-vkey v-cmd))
               (a e)
             )
  firefox    (on-press tap-vkey firefox)
  ff-nightly (on-press tap-vkey ff-nightly)
  kitty      (on-press tap-vkey kitty)
  app-sw     (macro (on-press press-vkey v-cmd) 5 tab)
)
(deflayermap (apps-windows)
  _   XX

  u A-tab
  i S-tab
  , @ltab
  . @rtab
  o @app-sw
  j @firefox
  k @kitty
  l @ff-nightly
)
