(defcfg
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  process-unmapped-keys no
  concurrent-tap-hold yes
  chords-v2-min-idle 5
  danger-enable-cmd yes
)

;; Kanata config for MacBook Pro M4 Pro Internal Keyboard (ANSI US)

(defsrc
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  grv       1         2         3         4         5         6         7         8         9         0         -         =         bspc
  tab       q         w         e         r         t         y         u         i         o         p         [         ]         \
  caps      a         s         d         f         g         h         j         k         l         ;         '         ret
  lsft      z         x         c         v         b         n         m         ,         .         /         rsft      up
            lctl      lalt      lmet                spc                                     rmet      ralt      left      down      rght
)

(deflayer base
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  grv       1         2         3         4         5         6         7         8         9         0         -         =         bspc
  tab       q         w         e         r         t         y         u         i         o         p         [         ]         \
  @esc-nav  @a-ctl    s         d         @f-apps   g         h         j         k         l         @scln-ctl @quot-nav ret
  lsft      z         x         c         v         b         n         m         ,         .         /         rsft      up
            lctl      lalt      lmet                spc                                     rmet      ralt      left      down      rght
)

(deflayer nav
  _         _         _         _         _         _         _         _         _         _         _         _         _
  _         _         _         _         _         _         _         _         _         _         _         _         _         _
  _         _         _         _         _         @newtab   @yank     @undo     pgup      _         @put      _         _     _
  _         @shcat    _         _         _         _         left      down      up        right     @shcat    @rcast    _
  _         _         @deltab   _         _         _         _         pgdn      _         _         @grep     _         _
            _         _         _                   _                                       _         _         _         _         _
)

;; (deflayer 
;;   _         _         _         _         _         _         _         _         _         _         _         _         _
;;   _         _         _         _         _         _         _         _         _         _         _         _         _         _
;;   _         _         _         _         _         _         _         _         _         _         _         _         _         _
