(defcfg
  macos-dev-names-include (
    "Node 75 LP-2"
  )
  process-unmapped-keys no
  concurrent-tap-hold yes
  chords-v2-min-idle 5
  danger-enable-cmd yes
)

(defsrc
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  grv       1         2         3         4         5         6         7         8         9         0         -         =         bspc      home
  tab       q         w         e         r         t         y         u         i         o         p         [         ]         \         end
  caps      a         s         d         f         g         h         j         k         l         ;         '                   ret       pgup
  lsft      z         x         c         v         b         n         m         ,         .         /                   rsft      up        pgdn
  lctl      lalt      lmet                          spc                                     rmet      fn        rctl      left      down      rght
)

(deflayer base
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  grv       1         2         3         4         5         6         7         8         9         0         -         =         bspc      home
  tab       q         @w-apps   e         r         t         y         u         i         o         p         [         ]         \         end
  @esc-nav  @a-ctl    s         d         f         g         h         j         k         l         @scln-ctl @quot-nav           ret       pgup
  lsft      z         x         c         v         b         n         m         ,         .         /         rsft      up                  pgdn
  lctl      lalt      lmet                          spc                                     rmet      fn        rctl      left      down      rght
)

(deflayer nav
  _         _         _         _         _         _         _         _         _         _         _         _         _
  _         _         _         _         _         _         _         _         _         _         _         _         _         _         _
  _         _         _         _         _         @newtab   @yank     @undo     pgup      _         @put      @ltab     @rtab     _         _
  _         @shcat    _         _         _         _         left      down      up        right     @shcat    @rcast    _                   _
  _         _         @deltab   _         _         _         _         pgdn      _         _         @grep     _         _                   _
  _         _         _                             _                                       _         _         _         _         _         _
)

