;; Vim-ish
;; `jk` to enter, `i` to exit

(defvirtualkeys
  hud-vim-nrm (cmd hud r#"Normal Mode"#)
  hud-vim-vis (cmd hud r#"Visual Mode"#)
  hud-dismiss (cmd hud -x)

  vim-ins (multi (layer-switch base) (on-press tap-vkey hud-dismiss))
  vim-nrm (multi (layer-switch vim-normal) (on-press tap-vkey hud-vim-nrm))
  vim-vis (multi (layer-switch vim-visual) (on-press tap-vkey hud-vim-vis))
)

(defchordsv2
  (j k) @vim-nrm 80 first-release (vim-normal vim-visual)
)

(defalias
  vim-ins (on-press tap-vkey vim-ins)
  vim-nrm (on-press tap-vkey vim-nrm)
  vim-vis (on-press tap-vkey vim-vis)

  vim-caret (macro M-left 5 A-right 5 A-left)
  vim-a     (macro M-right 5 (on-press tap-vkey vim-ins))
  vim-o     (macro M-right 5 ret 5 (on-press tap-vkey vim-ins))

  vim-yank-normal  M-c
  vim-paste-normal M-v
  vim-undo         M-z
  vim-redo         S-M-z

  vim-yank-visual (macro M-c 20 (on-press tap-vkey vim-nrm))
  vim-cut-visual  (macro M-x 20 (on-press tap-vkey vim-nrm))
  vim-chg-normal  (macro M-x 20 (on-press tap-vkey vim-ins))
  vim-del-visual  (macro bspc 20 (on-press tap-vkey vim-nrm))

  vim-grep (macro M-f 5 (on-press tap-vkey vim-ins))
)

;; Vim-ish normal mode
(deflayermap (vim-normal)
  _   XX

  i    @vim-ins
  esc  @vim-ins
  caps @vim-ins

  h   left
  j   down
  k   up
  l   right

  6   @vim-caret
  w   A-right
  b   A-left
  e   A-right

  0   M-left
  4   M-right
  g   M-up

  v   @vim-vis
  y   @vim-yank-normal
  p   @vim-paste-normal
  u   @vim-undo
  r   @vim-redo
  x   del

  /   @vim-grep

  a   @vim-a
  o   @vim-o
)

;; Vim-ish visual mode
(deflayermap (vim-visual)
  _   XX

  i    @vim-ins
  esc  @vim-nrm
  caps @vim-nrm
  v    @vim-nrm

  h   S-left
  j   S-down
  k   S-up
  l   S-right

  w   S-A-right
  b   S-A-left
  e   S-A-right

  0   S-M-left
  4   S-M-right
  g   S-M-up

  y   @vim-yank-visual
  d   @vim-del-visual
  x   @vim-cut-visual
  c   @vim-chg-normal
  p   @vim-paste-normal
)
